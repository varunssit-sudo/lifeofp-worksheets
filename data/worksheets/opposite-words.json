[
  {
    "id": "opposite-words-01",
    "topic": "opposite-words",
    "number": 1,
    "level": "Starter",
    "title": "Playing in the Park",
    "intro": "Zain and Meera are playing in the park. Opposite words mean completely different things, like up and down.",
    "sections": [
      {
        "type": "pairs",
        "title": "Write the opposite of each word.",
        "marks": 8,
        "items": [
          {
            "q": "up",
            "a": "down"
          },
          {
            "q": "big",
            "a": "small"
          },
          {
            "q": "fast",
            "a": "slow"
          },
          {
            "q": "hot",
            "a": "cold"
          },
          {
            "q": "open",
            "a": "close / shut"
          },
          {
            "q": "happy",
            "a": "sad"
          },
          {
            "q": "in",
            "a": "out"
          },
          {
            "q": "tall",
            "a": "short"
          }
        ]
      },
      {
        "type": "choice",
        "title": "Circle the opposite of the word in capitals.",
        "marks": 3,
        "items": [
          {
            "before": "LEFT :",
            "options": [
              "right",
              "side"
            ],
            "after": "",
            "a": "right"
          },
          {
            "before": "PUSH :",
            "options": [
              "shove",
              "pull"
            ],
            "after": "",
            "a": "pull"
          },
          {
            "before": "NEAR :",
            "options": [
              "far",
              "close"
            ],
            "after": "",
            "a": "far"
          }
        ]
      },
      {
        "type": "fill",
        "title": "Fill in the opposite of the word in brackets.",
        "marks": 3,
        "items": [
          {
            "q": "The swing went forward and then ___ (forward).",
            "a": "backward"
          },
          {
            "q": "Zain is tall, but his little brother is ___ (tall).",
            "a": "short"
          },
          {
            "q": "The slide is hot in the sun, but cool in the ___ (morning).",
            "a": "evening"
          }
        ]
      },
      {
        "type": "truefalse",
        "title": "Circle True or False.",
        "marks": 3,
        "items": [
          {
            "q": "\"Loud\" is the opposite of \"quiet\".",
            "a": true
          },
          {
            "q": "\"Big\" is the opposite of \"large\".",
            "a": false
          },
          {
            "q": "\"Top\" is the opposite of \"bottom\".",
            "a": true
          }
        ]
      }
    ]
  },
