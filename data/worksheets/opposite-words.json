        "marks": 4,
        "items": [
          {
            "before": "In summer, Dubai is very",
            "options": [
              "hot",
              "cold"
            ],
            "after": ".",
            "a": "hot"
          },
          {
            "before": "In winter, Delhi mornings are",
            "options": [
              "warm",
              "cold"
            ],
            "after": "and foggy.",
            "a": "cold"
          },
          {
            "before": "Summer days are long and winter days are",
            "options": [
              "short",
              "tall"
            ],
            "after": ".",
            "a": "short"
          },
          {
            "before": "Rehan wears a thick sweater in Delhi and a",
            "options": [
              "thin",
              "heavy"
            ],
            "after": "shirt in Dubai.",
            "a": "thin"
          }
        ]
      },
      {
        "type": "pairs",
        "title": "Write the opposite of each word.",
        "marks": 4,
        "items": [
          {
            "q": "summer",
            "a": "winter"
          },
          {
            "q": "sunny",
            "a": "cloudy / rainy"
          },
          {
            "q": "warm",
            "a": "cool"
          },
          {
            "q": "north",
            "a": "south"
          }
        ]
      },
      {
        "type": "match",
        "title": "Match each word to its opposite.",
        "marks": 4,
        "items": [
          {
            "left": "before",
            "right": "after"
          },
          {
            "left": "inside",
            "right": "outside"
          },
          {
            "left": "arrive",
            "right": "leave"
          },
          {
            "left": "high",
            "right": "low"
          }
        ]
      },
      {
        "type": "fill",
        "title": "Fill in the opposite of the word in brackets.",
        "marks": 3,
        "items": [
          {
            "q": "The air in Delhi was dry, but the grass was ___ (dry) with dew.",
            "a": "wet"
          },
          {
            "q": "Rehan's suitcase was full going there and ___ (full) coming back.",
            "a": "empty"
          },
          {
            "q": "The sky was dark at six, and ___ (dark) at seven.",
            "a": "light"
          }
        ]
      },
      {
        "type": "lines",
        "title": "Write one sentence about your favourite weather. Use an opposite pair.",
        "marks": 2,
        "lines": 1,
        "a": "Answers will vary, e.g. \"I like cool winter, not hot summer.\""
      }
