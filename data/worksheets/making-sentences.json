        "items": [
          {
            "q": "cuts / Ammi / onions / the",
            "a": "Ammi cuts the onions."
          },
          {
            "q": "the / Saanvi / rice / washes",
            "a": "Saanvi washes the rice."
          },
          {
            "q": "boils / water / the",
            "a": "The water boils."
          }
        ]
      },
      {
        "type": "fill",
        "title": "Fill in a word to finish the sentence.",
        "marks": 3,
        "items": [
          {
            "q": "Saanvi ___ the table.",
            "a": "e.g. sets / wipes / cleans"
          },
          {
            "q": "The milk is in the ___.",
            "a": "e.g. fridge / jug / glass"
          },
          {
            "q": "Ammi ___ the chapatis.",
            "a": "e.g. makes / rolls / cooks"
          }
        ]
      },
      {
        "type": "choice",
        "title": "Circle the word that comes next.",
        "marks": 3,
        "items": [
          {
            "before": "Please pass me",
            "options": [
              "the",
              "salt"
            ],
            "after": "salt.",
            "a": "the"
          },
          {
            "before": "We eat dinner at",
            "options": [
              "eight",
              "plate"
            ],
            "after": "o'clock.",
            "a": "eight"
          },
          {
            "before": "Saanvi is",
            "options": [
              "stir",
              "stirring"
            ],
            "after": "the dal.",
            "a": "stirring"
          }
        ]
      },
      {
        "type": "truefalse",
        "title": "Circle True or False.",
        "marks": 3,
        "items": [
          {
            "q": "\"Spoon the on table\" is a correct sentence.",
