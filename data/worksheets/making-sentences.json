  {
    "id": "making-sentences-03",
    "topic": "making-sentences",
    "number": 3,
    "level": "Starter",
    "title": "A Visit to the Doctor",
    "intro": "Ibrahim has a cold and visits Dr Mathew. A telling sentence ends with a full stop. An asking sentence ends with a question mark.",
    "sections": [
      {
        "type": "sort",
        "title": "Is it a telling sentence or an asking sentence?",
        "marks": 6,
        "groups": [
          "Telling",
          "Asking"
        ],
        "words": [
          "Where does it hurt",
          "I have a cough",
          "Can you open your mouth",
          "The nurse is kind",
          "Do I need medicine",
          "The clinic is busy"
        ],
        "a": {
          "Where does it hurt": "Asking",
          "I have a cough": "Telling",
          "Can you open your mouth": "Asking",
          "The nurse is kind": "Telling",
          "Do I need medicine": "Asking",
          "The clinic is busy": "Telling"
        }
      },
      {
        "type": "fill",
        "title": "Put a full stop (.) or a question mark (?) at the end.",
        "marks": 4,
        "items": [
          {
            "q": "How old are you ___",
            "a": "?"
          },
          {
            "q": "Ibrahim sat on the bed ___",
            "a": "."
          },
          {
            "q": "Is the medicine sweet ___",
            "a": "?"
          },
          {
            "q": "Dr Mathew checked my ears ___",
            "a": "."
          }
        ]
      },
      {
        "type": "choice",
        "title": "Circle the word that starts the asking sentence.",
        "marks": 3,
        "items": [
          {
            "before": "",
            "options": [
              "What",
              "Is"
            ],
            "after": "is your name?",
            "a": "What"
          },
          {
            "before": "",
            "options": [
              "Are",
              "When"
            ],
            "after": "you feeling better?",
            "a": "Are"
          },
          {
            "before": "",
            "options": [
              "How",
              "Can"
            ],
            "after": "I go to school tomorrow?",
            "a": "Can"
          }
        ]
      },
      {
        "type": "rewrite",
        "title": "Make an asking sentence to ask the doctor something.",
        "marks": 2,
        "items": [
          {
            "q": "Start with When, What, Can or Do.",
            "a": "Answers will vary; check a question mark, e.g. \"When will I get better?\""
          }
        ]
      },
      {
        "type": "truefalse",
        "title": "Circle True or False.",
        "marks": 3,
        "items": [
          {
            "q": "\"Do you have a fever?\" is an asking sentence.",
            "a": true
          },
          {
            "q": "An asking sentence ends with a full stop.",
            "a": false
          },
          {
            "q": "\"I feel much better.\" is a telling sentence.",
            "a": true
          }
        ]
      }
    ]
  },
