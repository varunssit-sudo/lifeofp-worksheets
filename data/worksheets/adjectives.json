          "basket",
          "sweet",
          "yellow",
          "banana",
          "juicy",
          "seller"
        ],
        "a": {
          "mango": "Naming word",
          "ripe": "Describing word",
          "basket": "Naming word",
          "sweet": "Describing word",
          "yellow": "Describing word",
          "banana": "Naming word",
          "juicy": "Describing word",
          "seller": "Naming word"
        }
      },
      {
        "type": "choice",
        "title": "Circle the word that fits best.",
        "marks": 4,
        "items": [
          {
            "before": "Lemons taste",
            "options": [
              "sour",
              "sweet"
            ],
            "after": ".",
            "a": "sour"
          },
          {
            "before": "A watermelon is",
            "options": [
              "big",
              "tiny"
            ],
            "after": "and heavy.",
            "a": "big"
          },
          {
            "before": "Ripe strawberries are",
            "options": [
              "red",
              "blue"
            ],
            "after": ".",
            "a": "red"
          },
          {
            "before": "A pineapple has a",
            "options": [
              "smooth",
              "rough"
            ],
            "after": "skin.",
            "a": "rough"
          }
        ]
      },
      {
        "type": "fill",
        "title": "Fill in with: round, green, soft, ten.",
        "marks": 4,
        "items": [
          {
            "q": "An orange is ___ like a ball.",
            "a": "round"
          },
          {
            "q": "Limes and peas are ___.",
            "a": "green"
          },
          {
            "q": "A ripe banana feels ___ when you press it.",
