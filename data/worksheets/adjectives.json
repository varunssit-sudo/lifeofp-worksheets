  {
    "id": "adjectives-03",
    "topic": "adjectives",
    "number": 3,
    "level": "Starter",
    "title": "Diwali Night Lights",
    "intro": "It is Diwali at Arjun's home. Find the describing words that tell how things look, sound and taste.",
    "sections": [
      {
        "type": "fill",
        "title": "Write the describing word in each sentence.",
        "marks": 5,
        "items": [
          {
            "q": "Arjun lit a bright diya. ___",
            "a": "bright"
          },
          {
            "q": "Mummy made sweet laddoos. ___",
            "a": "sweet"
          },
          {
            "q": "We heard loud crackers. ___",
            "a": "loud"
          },
          {
            "q": "Didi drew a colourful rangoli. ___",
            "a": "colourful"
          },
          {
            "q": "The lamps on the wall are gold. ___",
            "a": "gold"
          }
        ]
      },
      {
        "type": "sort",
        "title": "Sort the words by the sense they use.",
        "marks": 6,
        "groups": [
          "Looks",
          "Sounds",
          "Tastes"
        ],
        "words": [
          "shiny",
          "noisy",
          "spicy",
          "sparkly",
          "quiet",
          "sugary"
        ],
        "a": {
          "shiny": "Looks",
          "noisy": "Sounds",
          "spicy": "Tastes",
          "sparkly": "Looks",
          "quiet": "Sounds",
          "sugary": "Tastes"
        }
      },
      {
        "type": "choice",
        "title": "Circle the word that fits best.",
        "marks": 3,
        "items": [
          {
            "before": "The night sky was",
            "options": [
              "dark",
              "sour"
            ],
            "after": ".",
            "a": "dark"
          },
          {
            "before": "We wore",
            "options": [
              "tasty",
              "new"
            ],
            "after": "clothes for the puja.",
            "a": "new"
          },
          {
            "before": "The hot samosas were",
            "options": [
              "crispy",
              "tall"
            ],
            "after": ".",
            "a": "crispy"
          }
        ]
      },
      {
        "type": "truefalse",
        "title": "Circle True or False.",
        "marks": 3,
        "items": [
          {
            "q": "\"Loud\" tells us how something sounds.",
            "a": true
          },
          {
            "q": "\"Diya\" is a describing word.",
            "a": false
          },
          {
            "q": "A describing word tells us more about a naming word.",
            "a": true
          }
        ]
      },
      {
        "type": "lines",
        "title": "Write a sentence about Diwali with a describing word.",
        "marks": 2,
        "lines": 2,
        "a": "Answers will vary; check a fitting adjective, e.g. \"I lit a bright diya.\""
      }
    ]
  },
