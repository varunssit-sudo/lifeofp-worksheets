  {
    "id": "adjectives-05",
    "topic": "adjectives",
    "number": 5,
    "level": "Practice",
    "title": "Sports Day Races",
    "intro": "It is Sports Day at school. We add er to compare two things and est to compare more than two.",
    "sections": [
      {
        "type": "pairs",
        "title": "Add er and est to each word.",
        "marks": 4,
        "items": [
          {
            "q": "fast",
            "a": "faster, fastest"
          },
          {
            "q": "tall",
            "a": "taller, tallest"
          },
          {
            "q": "short",
            "a": "shorter, shortest"
          },
          {
            "q": "strong",
            "a": "stronger, strongest"
          }
        ]
      },
      {
        "type": "choice",
        "title": "Circle the correct word.",
        "marks": 4,
        "items": [
          {
            "before": "Zara is",
            "options": [
              "quick",
              "quicker"
            ],
            "after": "than Rohan.",
            "a": "quicker"
          },
          {
            "before": "Tom is the",
            "options": [
              "taller",
              "tallest"
            ],
            "after": "boy in the class.",
            "a": "tallest"
          },
          {
            "before": "The red team rope is",
            "options": [
              "longer",
              "longest"
            ],
            "after": "than the blue team rope.",
            "a": "longer"
          },
          {
            "before": "Neel ran the",
            "options": [
              "slower",
              "slowest"
            ],
            "after": "of all five runners.",
            "a": "slowest"
          }
        ]
      },
      {
        "type": "fill",
        "title": "Fill in the blank with the word in brackets plus er or est.",
        "marks": 4,
        "items": [
          {
            "q": "The sack race was ___ (hard) than the spoon race.",
            "a": "harder"
          },
          {
            "q": "Aisha jumped the ___ (high) of everyone.",
            "a": "highest"
          },
          {
            "q": "The big trophy is ___ (bright) than the small one.",
            "a": "brighter"
          },
          {
            "q": "Our team was the ___ (loud) when we cheered.",
            "a": "loudest"
          }
        ]
      },
      {
        "type": "truefalse",
        "title": "Circle True or False.",
        "marks": 3,
        "items": [
          {
            "q": "We use \"est\" when we compare only two children.",
            "a": false
          },
          {
            "q": "\"Smaller\" compares two things.",
            "a": true
          },
          {
            "q": "\"Fast, faster, fastest\" is in the right order.",
            "a": true
          }
        ]
      },
      {
        "type": "lines",
        "title": "Write about your best race using one describing word.",
        "marks": 2,
        "lines": 2,
        "a": "Answers will vary; check a fitting adjective, e.g. \"I was the fastest in the flat race.\""
