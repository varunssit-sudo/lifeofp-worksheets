[
  {
    "id": "fractions-01",
    "topic": "fractions",
    "number": 1,
    "level": "Starter",
    "title": "Sharing a Pizza at Home",
    "intro": "Mama cuts pizzas into equal parts for Tara, Kabir and the family. Each equal part is a fraction of the whole pizza.",
    "sections": [
      {
        "type": "match",
        "title": "Match each fraction to its name.",
        "marks": 5,
        "items": [
          {
            "left": "1/2",
            "right": "one half"
          },
          {
            "left": "1/4",
            "right": "one quarter"
          },
          {
            "left": "3/4",
            "right": "three quarters"
          },
          {
            "left": "2/2",
            "right": "two halves"
          },
          {
            "left": "4/4",
            "right": "four quarters"
          }
        ]
      },
      {
        "type": "fill",
        "title": "Fill in the missing word.",
        "marks": 4,
        "items": [
          {
            "q": "A pizza is cut into 2 equal parts. Each part is one ___.",
            "a": "half"
          },
          {
            "q": "A pizza is cut into 4 equal parts. Each part is one ___.",
            "a": "quarter"
          },
          {
            "q": "Two halves make one ___ pizza.",
            "a": "whole"
          },
          {
            "q": "Four quarters make ___ whole pizza.",
            "a": "one"
          }
        ]
      },
      {
        "type": "truefalse",
        "title": "Circle True or False.",
        "marks": 4,
        "items": [
          {
            "q": "One half is one of 2 equal parts.",
            "a": true
          },
          {
            "q": "One quarter is one of 4 equal parts.",
            "a": true
          },
          {
            "q": "A pizza cut into 4 pieces of different sizes shows quarters.",
            "a": false
          },
          {
            "q": "Half a pizza is bigger than a quarter of the same pizza.",
            "a": true
          }
        ]
      },
      {
        "type": "choice",
        "title": "Circle the right fraction.",
        "marks": 3,
        "items": [
          {
            "before": "Kabir ate 1 of 4 equal slices. He ate",
            "options": [
              "1/2",
              "1/4"
            ],
            "after": "of the pizza.",
            "a": "1/4"
          },
          {
            "before": "Tara ate 2 of 4 equal slices. She ate",
            "options": [
              "one half",
              "one quarter"
            ],
            "after": "of the pizza.",
            "a": "one half"
          },
          {
            "before": "Papa ate 3 of 4 equal slices. He ate",
            "options": [
              "one quarter",
              "three quarters"
            ],
            "after": "of the pizza.",
            "a": "three quarters"
          }
        ]
      },
      {
        "type": "lines",
        "title": "How can you share one pizza equally among 4 people?",
        "marks": 2,
        "lines": 1,
        "a": "Cut it into 4 equal parts; each person gets one quarter (1/4)."
      }
    ]
  },
