    "level": "Starter",
    "title": "Breakfast at Home",
    "intro": "Every sentence ends with a mark. Help Tanvi finish her breakfast sentences.",
    "sections": [
      {
        "type": "choice",
        "title": "Circle the right mark for the end.",
        "marks": 5,
        "items": [
          {
            "before": "Tanvi eats idli for breakfast",
            "options": [
              ".",
              "?"
            ],
            "after": "",
            "a": "."
          },
          {
            "before": "Do you want more chutney",
            "options": [
              ".",
              "?"
            ],
            "after": "",
            "a": "?"
          },
          {
            "before": "Papa drinks hot coffee",
            "options": [
              ".",
              "?"
            ],
            "after": "",
            "a": "."
          },
          {
            "before": "Where is my spoon",
            "options": [
              ".",
              "?"
            ],
            "after": "",
            "a": "?"
          },
          {
            "before": "Can I have some juice",
            "options": [
              ".",
              "?"
            ],
            "after": "",
            "a": "?"
          }
        ]
      },
      {
        "type": "truefalse",
        "title": "Circle True or False.",
        "marks": 4,
        "items": [
          {
            "q": "Every sentence starts with a capital letter.",
            "a": true
          },
          {
            "q": "A question ends with a full stop.",
            "a": false
          },
          {
            "q": "'What is your name' needs a question mark at the end.",
            "a": true
          },
          {
            "q": "The word 'I' is always a capital letter.",
            "a": true
          }
        ]
      },
      {
        "type": "sort",
        "title": "Is it a telling sentence or an asking sentence?",
        "marks": 6,
        "groups": [
          "Telling",
          "Asking"
        ],
        "words": [
          "My sister likes upma",
          "Who made the tea",
          "The toast is ready",
          "Are the eggs boiled",
          "Mama cuts the mango",
          "Why is the bread burnt"
        ],
        "a": {
          "My sister likes upma": "Telling",
          "Who made the tea": "Asking",
          "The toast is ready": "Telling",
          "Are the eggs boiled": "Asking",
          "Mama cuts the mango": "Telling",
          "Why is the bread burnt": "Asking"
        }
      },
      {
        "type": "rewrite",
        "title": "Write it correctly with a capital letter and an end mark.",
        "marks": 4,
        "items": [
          {
            "q": "tanvi likes poha",
            "a": "Tanvi likes poha."
          },
          {
            "q": "is the porridge hot",
            "a": "Is the porridge hot?"
          }
        ]
      },
      {
        "type": "lines",
        "title": "Write one question you ask at breakfast.",
        "marks": 2,
        "lines": 1,
        "a": "Answers will vary. It starts with a capital letter and ends with a question mark."
      }
    ]
  },
