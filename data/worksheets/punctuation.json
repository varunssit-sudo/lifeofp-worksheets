  {
    "id": "punctuation-04",
    "topic": "punctuation",
    "number": 4,
    "level": "Starter",
    "title": "Holi in the Colony",
    "intro": "Meera and her friends play Holi in their colony in Jaipur.",
    "sections": [
      {
        "type": "sort",
        "title": "Which mark goes at the end?",
        "marks": 6,
        "groups": [
          "Full stop",
          "Question mark",
          "Exclamation mark"
        ],
        "words": [
          "Who threw the blue colour",
          "Wow, what a mess",
          "We filled the water balloons",
          "Where is my pichkari",
          "Oh no, my shirt is pink",
          "Grandpa watched from the balcony"
        ],
        "a": {
          "Who threw the blue colour": "Question mark",
          "Wow, what a mess": "Exclamation mark",
          "We filled the water balloons": "Full stop",
          "Where is my pichkari": "Question mark",
          "Oh no, my shirt is pink": "Exclamation mark",
          "Grandpa watched from the balcony": "Full stop"
        }
      },
      {
        "type": "pairs",
        "title": "Write each word with a capital letter.",
        "marks": 6,
        "items": [
          {
            "q": "holi",
            "a": "Holi"
          },
          {
            "q": "jaipur",
            "a": "Jaipur"
          },
          {
            "q": "meera",
            "a": "Meera"
          },
          {
            "q": "march",
            "a": "March"
          },
          {
            "q": "sunday",
            "a": "Sunday"
          },
          {
            "q": "rajasthan",
            "a": "Rajasthan"
          }
        ]
      },
