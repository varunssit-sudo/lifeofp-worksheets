[
  {
    "id": "synonyms-01",
    "topic": "synonyms",
    "number": 1,
    "level": "Starter",
    "title": "My First Day in Class 2",
    "intro": "Synonyms are words that mean the same. Help Ira tell us about her first day.",
    "sections": [
      {
        "type": "match",
        "title": "Match the words that mean the same.",
        "marks": 5,
        "items": [
          {
            "left": "big",
            "right": "large"
          },
          {
            "left": "happy",
            "right": "glad"
          },
          {
            "left": "small",
            "right": "little"
          },
          {
            "left": "quick",
            "right": "fast"
          },
          {
            "left": "start",
            "right": "begin"
          }
        ]
      },
      {
        "type": "choice",
        "title": "Circle the word that means the same.",
        "marks": 4,
        "items": [
          {
            "before": "The classroom was neat. It was",
            "options": [
              "tidy",
              "messy",
              "dirty"
            ],
            "after": ".",
            "a": "tidy"
          },
          {
            "before": "Ira's teacher is kind. She is",
            "options": [
              "nice",
              "rude",
              "loud"
            ],
            "after": ".",
            "a": "nice"
          },
          {
            "before": "The bell was loud. It was",
            "options": [
              "noisy",
              "quiet",
              "soft"
            ],
            "after": ".",
            "a": "noisy"
          },
          {
            "before": "Ira was a bit afraid. She was",
            "options": [
              "scared",
              "brave",
              "bored"
            ],
            "after": ".",
            "a": "scared"
          }
        ]
      },
      {
        "type": "truefalse",
        "title": "Circle True or False.",
        "marks": 4,
        "items": [
          {
            "q": "'Shut' and 'close' mean the same.",
            "a": true
          },
          {
            "q": "'Hot' and 'cold' are synonyms.",
            "a": false
          },
          {
            "q": "'Shout' and 'yell' mean the same.",
            "a": true
          },
          {
            "q": "'Laugh' and 'cry' are synonyms.",
            "a": false
          }
        ]
      },
      {
        "type": "fill",
        "title": "Fill in a word that means the same as the word in brackets. Use: friend, talk, pick, gift.",
        "marks": 4,
        "items": [
          {
            "q": "Ira made a new ___ (pal).",
            "a": "friend"
          },
          {
            "q": "We ___ (chat) at break time.",
            "a": "talk"
          },
          {
            "q": "You can ___ (choose) any seat.",
            "a": "pick"
          },
          {
            "q": "Ms Ali gave Ira a ___ (present).",
            "a": "gift"
          }
        ]
      },
      {
        "type": "lines",
        "title": "Write one sentence about your class. Use fast or quick.",
        "marks": 2,
        "lines": 1,
        "a": "Answers will vary, e.g. I am the fastest runner in my class."
      }
    ]
  },
