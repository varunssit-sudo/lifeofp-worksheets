          },
          {
            "q": "We use 'it' for a ball or a box.",
            "a": true
          },
          {
            "q": "We use 'he' for a girl.",
            "a": false
          }
        ]
      },
      {
        "type": "lines",
        "title": "Write one sentence about a race you ran. Use I or we.",
        "marks": 2,
        "lines": 1,
        "a": "Answers will vary. The sentence uses I or we, e.g. We ran very fast."
