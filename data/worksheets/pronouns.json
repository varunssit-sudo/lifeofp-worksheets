      {
        "type": "fill",
        "title": "Fill in with him, her, it or them.",
        "marks": 4,
        "items": [
          {
            "q": "Omar dropped the baton. Coach picked ___ up.",
            "a": "it"
          },
          {
            "q": "Kavya was tired, so Mama gave ___ a hug.",
