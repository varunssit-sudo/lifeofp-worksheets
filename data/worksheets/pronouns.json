  {
    "id": "pronouns-01",
    "topic": "pronouns",
    "number": 1,
    "level": "Starter",
    "title": "Meet My Family",
    "intro": "Siya tells us about her family. Use he, she, it, they and we.",
    "sections": [
      {
        "type": "pairs",
        "title": "Write he, she, it or they.",
        "marks": 8,
        "items": [
          {
            "q": "Papa",
            "a": "he"
          },
          {
            "q": "Nani",
            "a": "she"
          },
          {
            "q": "the dog",
            "a": "it"
          },
          {
            "q": "my brothers",
            "a": "they"
          },
          {
            "q": "Aunt Meena",
            "a": "she"
          },
          {
            "q": "the car",
            "a": "it"
          },
          {
            "q": "Uncle Raj",
            "a": "he"
          },
          {
            "q": "the twins",
            "a": "they"
          }
        ]
      },
      {
        "type": "choice",
        "title": "Circle the right pronoun.",
        "marks": 4,
        "items": [
          {
            "before": "Mama is a doctor.",
            "options": [
              "She",
              "He"
            ],
            "after": "works at a hospital.",
            "a": "She"
          },
          {
            "before": "My brother Arjun is six.",
            "options": [
              "He",
              "It"
            ],
            "after": "likes cricket.",
            "a": "He"
          },
          {
            "before": "Our cat is white.",
            "options": [
              "It",
              "They"
            ],
            "after": "sleeps all day.",
            "a": "It"
          },
          {
            "before": "Siya and I play ludo.",
            "options": [
              "We",
              "They"
            ],
            "after": "play every evening.",
            "a": "We"
          }
        ]
      },
      {
        "type": "fill",
        "title": "Fill in with I, we or they.",
        "marks": 4,
        "items": [
          {
            "q": "My name is Siya. ___ am seven years old.",
            "a": "I"
          },
          {
            "q": "My grandparents live in Pune. ___ visit us in summer.",
            "a": "They"
          },
          {
            "q": "Arjun and I share a room. ___ keep it tidy.",
            "a": "We"
          },
          {
            "q": "My cousins live in Abu Dhabi. ___ have a big garden.",
            "a": "They"
          }
        ]
      },
      {
        "type": "rewrite",
        "title": "Write the sentence again. Change the name to he, she, it or they.",
        "marks": 4,
        "items": [
          {
            "q": "Nani makes tea every morning.",
            "a": "She makes tea every morning."
          },
          {
            "q": "The puppies drink milk.",
            "a": "They drink milk."
          }
        ]
      },
      {
        "type": "lines",
        "title": "Write two sentences about someone in your family. Use he or she.",
        "marks": 2,
        "lines": 2,
        "a": "Answers will vary. The second sentence uses he or she in place of the name."
      }
    ]
  },
